{
  "manifest_version": 3,
  "name": "jab",
  "version": "0.6.1",
  "background": {
    "service_worker": "jab.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["jab.js"],
      "all_frames": true
    }
  ],
  "homepage_url": "https://jab.run",
  "description": "Press Ctrl+Q to jump to the link, button or box you most likely want next.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
